# --- Auth0 (https://auth0.com) ---
# Long random string: `openssl rand -hex 32`
AUTH0_SECRET=
# Your app base URL (use http://localhost:3000 locally)
APP_BASE_URL=http://localhost:3000
# Auth0 tenant domain, e.g. dev-xxxx.us.auth0.com
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=

# --- MongoDB Atlas ---
# Full connection string, e.g. mongodb+srv://USER:PASS@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=
MONGODB_DB=reelforge

# --- Google Gemini ---
# Get an API key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
